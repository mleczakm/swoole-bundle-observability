{
  "name": "mleczakm/swoole-bundle-observability",
  "description": "Runtime process, memory, file-descriptor and TCP observability for Symfony applications running on Swoole.",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": ["swoole", "symfony", "observability", "health-check", "sentry", "metrics"],
  "authors": [{"name": "Michał Mleczko", "email": "do@mleczki.pl"}],
  "require": {
    "php": "^8.3",
    "macpaw/symfony-health-check-bundle": "^2.1",
    "psr/log": "^3.0",
    "sentry/sentry": "^4.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/filesystem": "^7.4 || ^8.0",
    "symfony/http-client-contracts": "^3.5",
    "symfony/http-kernel": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5 || ^12.5",
    "symfony/http-client": "^7.4 || ^8.0"
  },
  "autoload": {"psr-4": {"SwooleBundle\\Observability\\": "src/"}},
  "autoload-dev": {"psr-4": {"SwooleBundle\\Observability\\Tests\\": "tests/"}},
  "config": {"sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
